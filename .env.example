# Copy to .env for local use. NEVER commit .env. This file holds placeholders only.
# (The server reads real environment variables; use `node --env-file=.env src/server.js` or your host's dashboard.)

NODE_ENV=development
# HOST defaults to 127.0.0.1 locally and 0.0.0.0 when NODE_ENV=production or RENDER is set.
# PORT is provided by Render; locally it defaults to 3000.
# HOST=127.0.0.1
# PORT=3000

# JSON state file. Render: only durable with a paid persistent disk (e.g. /var/data/state.json).
# CLAIMTRAIL_DATA=./data/state.json

# rules (default, fully offline) | sarvam (optional cloud document analysis + translation, per-action consent)
AI_PROVIDER=rules
# Server-side secret. Set ONLY in Render's environment (or a local .env). Never in Vercel, never in the browser.
SARVAM_API_KEY=

# Exact browser origins allowed by CORS, comma separated, no wildcards, no trailing paths.
FRONTEND_ORIGINS=

# Disable local Tesseract OCR (it is optional and auto-detected): CLAIMTRAIL_OCR=off

# --- Vercel build only (PUBLIC, not a secret): origin of the Render API ---
# CLAIMTRAIL_API_BASE_URL=https://claimtrail-api.onrender.com
